{
  "name": "messaging-app",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "test": "vitest run tests/unit",
    "test:security": "node --env-file=.env.local node_modules/vitest/vitest.mjs run tests/security",
    "test:e2e": "node --env-file=.env.local node_modules/@playwright/test/cli.js test",
    "setup:users": "node --env-file=.env.local scripts/setup-users.mjs",
    "db:types": "supabase gen types typescript --local > types/database.ts",
    "icons": "node scripts/generate-icons.mjs",
    "ui-assets": "node scripts/build-ui-assets.mjs",
    "contrast": "node scripts/check-contrast.mjs"
  },
  "dependencies": {
    "@supabase/ssr": "^0.12.7",
    "@supabase/supabase-js": "^2.117.1",
    "framer-motion": "^13.4.2",
    "next": "16.3.6",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "server-only": "^0.0.1"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^22.20.4",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.3.6",
    "supabase": "^2.117.0",
    "tailwindcss": "^4",
    "typescript": "^5",
    "vitest": "^5.0.1"
  },
  "engines": {
    "node": ">=20.9"
  }
}
