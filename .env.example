# ─── Supabase (public, safe for the browser) ───────────────────────────────
# Project Settings → API. The publishable key is designed to be public;
# Row Level Security is what protects the data.
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxxxxxxxxxxxxxxxxx

# ─── Web Push (public key only; see README "Pop-up notifications") ─────────
# From `npm run push:keys`. The private key goes to `supabase secrets set`,
# never here.
NEXT_PUBLIC_VAPID_PUBLIC_KEY=

# ─── Server / scripts only — NEVER prefix with NEXT_PUBLIC_ ────────────────
# Secret key (or legacy service_role key). Bypasses RLS.
# Used only by scripts/setup-users.mjs and the e2e tests. The app never reads it.
SUPABASE_SECRET_KEY=sb_secret_xxxxxxxxxxxxxxxxxxxx

# ─── The two private accounts (used once by `npm run setup:users`) ──────────
# Keep these in .env.local only. Passwords: 10+ characters.
SETUP_USER_1_EMAIL=you@example.com
SETUP_USER_1_PASSWORD=change-me-please
SETUP_USER_1_USERNAME=shiru
SETUP_USER_1_DISPLAY_NAME=Shiru

SETUP_USER_2_EMAIL=boyfriend@example.com
SETUP_USER_2_PASSWORD=change-me-too-please
SETUP_USER_2_USERNAME=boyfriend
SETUP_USER_2_DISPLAY_NAME=Boyfriend
